# Local defaults (no secrets: the passwords exist only in the local containers).
PORT=7202
SERVICE_NAME=driver-service
DATABASE_URL=postgres://drivers_svc:drivers@localhost:5455/drivers
REDIS_URL=redis://localhost:6401
KAFKA_BROKERS=localhost:9205
# Stops the Prisma CLI from checking for updates and sending telemetry (no outside calls).
CHECKPOINT_DISABLE=1
PRISMA_HIDE_UPDATE_MESSAGE=1
