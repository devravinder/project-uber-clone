@rider = http://localhost:7201

### Seed riders hr001..hr005 (idempotent)
POST {{rider}}/admin/seed
Content-Type: application/json

{ "count": 5, "prefix": "hr" }

?? status == 200
?? body total >= 5

### Update a profile
PUT {{rider}}/riders/hr001
Content-Type: application/json
X-User: hr001

{ "name": "Ravi" }

?? status == 200
?? body name == Ravi

### Only the rider may edit their profile: 403
PUT {{rider}}/riders/hr001
Content-Type: application/json
X-User: hr002

{ "name": "Not me" }

?? status == 403
?? body code == NOT_YOUR_PROFILE

### Read a rider
GET {{rider}}/riders/hr001

?? status == 200
?? body id == hr001

### Unknown rider is 404
GET {{rider}}/riders/nobody_here

?? status == 404
?? body code == RIDER_NOT_FOUND

### List riders by cursor
GET {{rider}}/riders?limit=2

?? status == 200
?? js response.parsedBody.items.length == 2

### Estimate a ride (pricing-service behind the scenes)
# @name quote
POST {{rider}}/rides/estimate
Content-Type: application/json
X-User: hr001

{
  "pickup": { "lat": 12.9716, "lng": 77.5946 },
  "dropoff": { "lat": 13.01, "lng": 77.62 }
}

?? status == 200
?? body riderId == hr001
?? body fareMinor >= 8000

### An unknown rider cannot get an estimate: 404
POST {{rider}}/rides/estimate
Content-Type: application/json
X-User: nobody_here

{
  "pickup": { "lat": 12.9716, "lng": 77.5946 },
  "dropoff": { "lat": 13.01, "lng": 77.62 }
}

?? status == 404
?? body code == RIDER_NOT_FOUND

### Validation errors come back with pricing-service's code
POST {{rider}}/rides/estimate
Content-Type: application/json
X-User: hr001

{
  "pickup": { "lat": 12.9716, "lng": 77.5946 },
  "dropoff": { "lat": 12.9716, "lng": 77.5946 }
}

?? status == 400
?? body code == INVALID_REQUEST

### Request the ride: 201 requested
# @name ride
POST {{rider}}/rides
Content-Type: application/json
X-User: hr001

{ "quoteId": "{{quote.id}}" }

?? status == 201
?? body status == requested

### The same request again (a client retry): 200, same trip
POST {{rider}}/rides
Content-Type: application/json
X-User: hr001

{ "quoteId": "{{quote.id}}" }

?? status == 200
?? body id == {{ride.id}}

### The current ride
GET {{rider}}/rides/current
X-User: hr001

?? status == 200
?? body trip.id == {{ride.id}}

### Cancel the ride
POST {{rider}}/rides/{{ride.id}}/cancel
Content-Type: application/json
X-User: hr001

{ "reason": "testing" }

?? status == 200
?? body status == cancelled
?? body cancelledBy == rider

### No current ride now
GET {{rider}}/rides/current
X-User: hr001

?? status == 200
?? body trip == null

### Ride history, newest first
GET {{rider}}/rides?limit=5
X-User: hr001

?? status == 200
?? body items.0.id == {{ride.id}}

### Counters
GET {{rider}}/admin/stats

?? status == 200
?? body requests >= 2
